# ─── Backend (Laravel) ────────────────────────────────────────
# Generar con: php artisan key:generate
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

# Base de datos PostgreSQL (contenedor docker)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=catalogo
DB_USERNAME=catalogo
DB_PASSWORD=catalogo_secret

# Redis: caché, colas y sesiones
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_HOST=redis
REDIS_PORT=6379

# WhatsApp (formato internacional sin espacios, ej: 57xxxxxx)
WHATSAPP_NUMBER=5492646214599

# ─── Nginx / Puerto ───────────────────────────────────────────
HTTP_PORT=80
HTTPS_PORT=443

# ─── Frontend (React) ─────────────────────────────────────────
# En producción los assets usan /api/v1 (relativo, lo proxea Nginx)
VITE_API_URL=/api/v1
VITE_WHATSAPP_NUMBER=5492646214599